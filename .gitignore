# Personal paths to game files and keys (see config.example.toml)
/config.local.toml

# Game inputs and everything derived from them. NEVER commit these.
# tools/check_content.py enforces the same rule in CI and in the pre-commit hook.
/game/
/build/
/generated/
/refs/
/toolchain/
*.xci
*.xcz
*.nsp
*.nsz
*.nca
*.ncz
*.tik
*.cert
*.keys
*.nso
*.nro
*.npdm
*.trpak
*.trpfs
*.trpfd
*.bntx
*.bnsh
*.sarc
*.zs
*.webm

# Python environments and caches
/.venv/
/.venv-*/
__pycache__/

# Build outputs
*.exe
*.dll
*.pdb
*.obj
*.o
*.lib
*.a

# Ninja state
.ninja_log
.ninja_deps

# Logs, editor and OS files
*.log
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Launcher build output (tools/make_launcher.py)
/dist/
/launcher/bin/
/launcher/obj/

# Launcher's own mod list (written next to the installed game, not source)
/mods.json

# Building directly into the repo (launcher Builder.cs Install/python setup): the embeddable Python package and the
# play shortcut it creates in the target folder
/python/
*.lnk
